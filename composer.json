{
  "name": "epsilon-ia/epsilon-os",
  "description": "EPSILON OS — API native PHP",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "phpmailer/phpmailer": "^6.9",
    "setasign/fpdi": "^2.6",
    "tecnickcom/tcpdf": "^6.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Epsilon\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Epsilon\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M"
  }
}
